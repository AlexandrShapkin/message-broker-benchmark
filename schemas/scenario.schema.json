{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "experiment",
    "sut",
    "clients",
    "traffic",
    "topology",
    "connection",
    "timing",
    "collection",
    "repetitions",
    "random_seed",
    "fault",
    "matrix"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
    },
    "experiment": {
      "type": "string",
      "enum": [
        "connection_density",
        "message_rate",
        "payload_size",
        "fan_out",
        "many_to_one",
        "many_to_many",
        "mostly_idle",
        "slow_consumer",
        "reconnect_storm",
        "broker_restart"
      ]
    },
    "sut": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "broker",
        "profile",
        "mode",
        "image_digest"
      ],
      "properties": {
        "broker": {
          "type": "string",
          "enum": [
            "nats",
            "mosquitto",
            "rabbitmq",
            "kafka"
          ]
        },
        "profile": {
          "type": "string",
          "enum": [
            "fast",
            "durable"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "clean",
            "reuse"
          ]
        },
        "image_digest": {
          "type": "string",
          "pattern": "^(|sha256:[0-9a-f]{64})$"
        }
      }
    },
    "clients": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producers",
        "consumers",
        "active_producers",
        "active_consumers"
      ],
      "properties": {
        "producers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "consumers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "active_producers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "active_consumers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      }
    },
    "traffic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "total_rate_messages_per_sec",
        "payload_bytes",
        "consumer_delay_ms",
        "queue_capacity",
        "rate_tolerance",
        "burst_multiplier",
        "burst_every_seconds",
        "burst_duration_seconds"
      ],
      "properties": {
        "model": {
          "type": "string",
          "enum": [
            "open_loop"
          ]
        },
        "total_rate_messages_per_sec": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000.0
        },
        "payload_bytes": {
          "type": "integer",
          "minimum": 64,
          "maximum": 16777216
        },
        "consumer_delay_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "queue_capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "rate_tolerance": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "burst_multiplier": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "burst_every_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "burst_duration_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "channels",
        "delivery"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "one_to_many",
            "many_to_one",
            "many_to_many"
          ]
        },
        "channels": {
          "const": 1
        },
        "delivery": {
          "type": "string",
          "enum": [
            "broadcast",
            "competing"
          ]
        }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ramp_clients_per_second",
        "timeout_seconds",
        "operation_timeout_ms"
      ],
      "properties": {
        "ramp_clients_per_second": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "operation_timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warmup_seconds",
        "measurement_seconds",
        "cooldown_seconds"
      ],
      "properties": {
        "warmup_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "measurement_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "cooldown_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_interval_ms",
        "latency_histograms",
        "operation_samples",
        "max_intervals"
      ],
      "properties": {
        "system_interval_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 1000
        },
        "latency_histograms": {
          "const": true
        },
        "operation_samples": {
          "type": "boolean"
        },
        "max_intervals": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        }
      }
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "random_seed": {
      "type": "integer"
    },
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at_seconds",
        "fraction",
        "downtime_seconds",
        "repeat_seconds"
      ],
      "properties": {
        "at_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "downtime_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "repeat_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis",
        "values"
      ],
      "properties": {
        "axis": {
          "type": "string",
          "enum": [
            "",
            "clients",
            "rate",
            "payload",
            "consumers"
          ]
        },
        "values": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000.0
          },
          "maxItems": 10000
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
